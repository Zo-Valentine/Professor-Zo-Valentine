source "https://rubygems.org"

# Plain jekyll rather than the "github-pages" meta-gem: that gem pins to whatever Jekyll/plugin
# versions GitHub's production build currently supports, which frequently lags the Ruby version
# available locally and turns local preview into a dependency-resolution problem instead of a
# preview. This trades exact GitHub Pages parity for a preview that actually runs; revisit if a
# real parity issue shows up (a plugin GitHub supports that plain Jekyll doesn't).
gem "jekyll", "~> 4.4"
gem "webrick"
